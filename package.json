{
  "name": "personal-health-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "npm run dev --workspace @health/web",
    "dev:netlify": "netlify dev",
    "build": "npm run typecheck && npm run build --workspace @health/web",
    "typecheck": "npm run typecheck --workspace @health/shared && npm run typecheck --workspace @health/web && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "@netlify/functions": "6.0.0",
    "google-auth-library": "11.1.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
